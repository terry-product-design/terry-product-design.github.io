---
interface Props {
  title: string;
  scenario?: string;
  points?: string[];
  /** Alternative layout: labelled rows (e.g. pain point / business need / solution). */
  rows?: { label: string; text: string }[];
  flip?: boolean;
  /** Narrower media column, for phones. */
  narrow?: boolean;
  /** Heading level for the title, to keep the outline valid where it's used. */
  level?: 3 | 4;
}
const { scenario, title, points = [], rows, flip = false, narrow = false, level = 4 } = Astro.props;
const H = `h${level}`;
---

<article class:list={['feature', { 'feature--flip': flip, 'feature--narrow': narrow }]} data-feature>
  <div class="feature__media">
    <slot name="media" />
  </div>
  {rows ? (
    <div class="feature__text">
      <H class="feature__title">{title}</H>
      <dl class="feature__rows">
        {rows.map((r) => (
          <div>
            <dt class="kicker">{r.label}</dt>
            <dd>{r.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  ) : (
  <div class="feature__text">
    <div class="feature__block">
      <p class="kicker">Scenario</p>
      <p class="feature__scenario">{scenario}</p>
    </div>
    <div class="feature__block">
      <p class="kicker">Feature</p>
      <H class="feature__title">{title}</H>
      <ol class="feature__points">
        {
          points.map((p, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <span>{p}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
  )}
</article>

<style>
  .feature {
    display: grid;
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }
  .feature__media {
    width: min(100%, 440px);
    justify-self: center;
  }
  .feature__text {
    display: grid;
    gap: 36px;
  }
  .feature__block {
    display: grid;
    gap: 12px;
  }
  .feature__scenario {
    font-size: clamp(18px, 1.5vw, 23px);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--fg);
    max-width: 40ch;
  }
  .feature__title {
    font-size: clamp(26px, 2.4vw, 40px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .feature__points {
    display: grid;
    margin-top: 6px;
    border-top: 1px solid var(--line);
  }
  .feature__points li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 10px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-2);
    line-height: 1.5;
  }
  .feature__points li > span:first-child {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-3);
    padding-top: 0.4em;
  }
  .feature__rows {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .feature__rows div {
    display: grid;
    gap: 8px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .feature__rows dd {
    margin: 0;
    color: var(--fg-2);
    line-height: 1.55;
    max-width: 46ch;
  }
  .feature__rows div:last-child dd {
    color: var(--fg);
  }
  .feature--narrow .feature__media {
    width: min(100%, 320px);
  }
  @media (min-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    }
    .feature--narrow {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    }
    .feature--flip .feature__media {
      order: 2;
    }
  }
</style>
