---
import { site } from '../data/content';

interface Props {
  /** On sub-pages, section links point back to the homepage. */
  home?: boolean;
}
const { home = true } = Astro.props;
const homeUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = home ? '' : homeUrl;

const links = [
  { href: `${prefix}#about`, key: 'about', label: 'About' },
  { href: `${prefix}#work`, key: 'work', label: 'Work' },
  { href: `${prefix}#experience`, key: 'experience', label: 'Experience' },
  { href: `${prefix}#explorations`, key: 'explorations', label: 'Explorations' },
];
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a href={home ? '#top' : homeUrl} class="nav__brand" aria-label={home ? 'Terry Wu — back to top' : 'Terry Wu — home'} data-magnetic="0.25">
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
        <g class="mark__chaos">
          <path d="M5 5 L19 19 M19 5 L5 19 M5 5 L19 12" />
        </g>
        <g class="mark__order">
          <path d="M5 5 H19 V19 H5 Z M12 5 V19" />
        </g>
        <circle cx="5" cy="5" r="2" /><circle cx="19" cy="5" r="2" />
        <circle cx="5" cy="19" r="2" /><circle cx="19" cy="19" r="2" />
      </svg>
      <span class="nav__name">Terry Wu</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((l, i) => (
          <a href={l.href} class:list={['nav__link', { 'is-active': !home && l.key === 'work' }]} data-section-link={home ? l.key : undefined}>
            <span class="nav__num">0{i + 1}</span>
            <span class="roll">
              <span class="roll__inner" data-text={l.label}>
                {l.label}
              </span>
            </span>
          </a>
        ))
      }
    </nav>

    <div class="nav__meta">
      <a class="nav__resume" href={site.resume} target="_blank" rel="noopener">
        <span class="roll"><span class="roll__inner" data-text="Résumé ↗">Résumé ↗</span></span>
      </a>
      <a class="btn btn--ghost nav__cta" href={site.linkedin} target="_blank" rel="noopener" data-magnetic="0.3">
        <span class="nav__dot" aria-hidden="true"></span>
        <span class="roll"><span class="roll__inner" data-text="Get in touch">Get in touch</span></span>
      </a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Menu</span>
        <span class="nav__burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
  <div class="nav__progress" aria-hidden="true"><span data-progress></span></div>
</header>

<div class="menu" id="menu" data-menu aria-hidden="true">
  <nav class="menu__inner container" aria-label="Mobile">
    {
      links.map((l, i) => (
        <a href={l.href} class="menu__link" tabindex="-1">
          <span class="menu__num">0{i + 1}</span>
          <span class="menu__label">{l.label}</span>
        </a>
      ))
    }
    <div class="menu__foot">
      <a href={site.resume} target="_blank" rel="noopener" tabindex="-1">Résumé ↗</a>
      <a href={site.linkedin} target="_blank" rel="noopener" tabindex="-1">LinkedIn ↗</a>
    </div>
  </nav>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 80;
    height: var(--nav-h);
    transition: transform 0.7s var(--ease-out);
  }
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(8, 5, 15, 0.85), rgba(8, 5, 15, 0));
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  :global(.nav-scrolled) .nav::before {
    opacity: 1;
  }
  :global(.nav-hidden) .nav {
    transform: translateY(-110%);
  }
  :global(.menu-open) .nav {
    transform: none;
  }
  .nav__inner {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
    font-weight: 500;
    font-size: 16px;
    letter-spacing: -0.02em;
  }
  .mark {
    width: 24px;
    height: 24px;
    fill: var(--fg);
    stroke: var(--fg);
    stroke-width: 1.2;
    overflow: visible;
  }
  .mark path {
    fill: none;
  }
  .mark__chaos,
  .mark__order {
    transition: opacity 0.5s var(--ease-out), transform 0.7s var(--ease-out);
    transform-origin: 12px 12px;
  }
  .mark__order {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
    stroke: var(--accent);
  }
  .nav__brand:hover .mark__chaos {
    opacity: 0;
    transform: rotate(45deg) scale(0.6);
  }
  .nav__brand:hover .mark__order {
    opacity: 1;
    transform: none;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: rgba(19, 17, 27, 0.55);
    border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--fg-2);
    transition: color 0.4s ease, background-color 0.4s ease;
  }
  .nav__link:hover,
  .nav__link.is-active {
    color: var(--fg);
  }
  .nav__link.is-active {
    background: rgba(241, 241, 241, 0.07);
  }
  .nav__num {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--fg-3);
  }
  .nav__link.is-active .nav__num {
    color: var(--accent);
  }

  .nav__meta {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav__resume {
    display: none;
    font-size: 14px;
    color: var(--fg-2);
    transition: color 0.3s ease;
  }
  .nav__resume:hover {
    color: var(--fg);
  }
  .nav__cta {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
    gap: 10px;
    background: rgba(19, 17, 27, 0.55);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .nav__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.6);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px rgba(74, 222, 128, 0);
    }
  }

  .nav__toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgba(19, 17, 27, 0.55);
  }
  .nav__burger {
    position: relative;
    width: 16px;
    height: 8px;
  }
  .nav__burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--fg);
    transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out);
  }
  .nav__burger span:first-child {
    top: 0;
  }
  .nav__burger span:last-child {
    top: 6.5px;
  }
  :global(.menu-open) .nav__burger span:first-child {
    top: 3.25px;
    transform: rotate(45deg);
  }
  :global(.menu-open) .nav__burger span:last-child {
    top: 3.25px;
    transform: rotate(-45deg);
  }

  .nav__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  :global(.nav-scrolled) .nav__progress {
    opacity: 1;
  }
  .nav__progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--accent));
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  @media (max-width: 599px) {
    .nav__cta {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .nav__links {
      display: inline-flex;
    }
    .nav__resume {
      display: inline-flex;
    }
    .nav__toggle {
      display: none;
    }
  }

  /* Mobile menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgba(8, 5, 15, 0.97);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--ease-in-out);
    visibility: hidden;
  }
  :global(.menu-open) .menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
  }
  .menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    gap: 4px;
    padding-top: var(--nav-h);
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(40px, 11vw, 72px);
    letter-spacing: -0.04em;
    line-height: 1.05;
    transform: translateY(40px);
    opacity: 0;
    transition: transform 0.8s var(--ease-out), opacity 0.8s var(--ease-out);
  }
  :global(.menu-open) .menu__link {
    transform: none;
    opacity: 1;
  }
  .menu__link:nth-child(2) {
    transition-delay: 0.05s;
  }
  .menu__link:nth-child(3) {
    transition-delay: 0.1s;
  }
  .menu__link:nth-child(4) {
    transition-delay: 0.15s;
  }
  .menu__num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }
  .menu__foot {
    display: flex;
    gap: 24px;
    margin-top: 32px;
    color: var(--fg-2);
  }
</style>
