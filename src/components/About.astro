---
import { Picture } from 'astro:assets';
import { about, site } from '../data/content';

// Words rendered in the serif accent face.
const accent = new Set(['Terry', 'simple.']);
const words = about.statement.split(' ');

// Deterministic pseudo-random for the pillar diagrams.
let seed = 11;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

// Research: scattered notes -> three affinity clusters
const clusters = [
  { x: 52, y: 74 },
  { x: 104, y: 46 },
  { x: 152, y: 88 },
];
const researchDots = Array.from({ length: 21 }, (_, i) => {
  const c = clusters[i % 3];
  const a = rnd() * Math.PI * 2;
  const d = 5 + rnd() * 15;
  return {
    x0: 14 + rnd() * 172,
    y0: 14 + rnd() * 112,
    x1: +(c.x + Math.cos(a) * d).toFixed(1),
    y1: +(c.y + Math.sin(a) * d).toFixed(1),
    d: (i * 0.025).toFixed(3),
  };
});

// Systems: loose modules -> 3x3 grid
const sysBlocks = Array.from({ length: 9 }, (_, i) => ({
  x0: 18 + rnd() * 150,
  y0: 14 + rnd() * 100,
  r0: Math.round((rnd() - 0.5) * 120),
  x1: 64 + (i % 3) * 30,
  y1: 32 + Math.floor(i / 3) * 30,
  d: (i * 0.04).toFixed(2),
}));
---

<section class="about section" id="about" data-section="about">
  <div class="container">
    <h2 class="label about__label" data-reveal="fade-up">
      <span class="label__index">01</span><span class="label__rule"></span><span>About</span>
    </h2>

    <div class="about__grid">
      <p class="about__statement" data-words>
        {
          words.map((w) => (
            <>
              <span class:list={['w', { serif: accent.has(w) }]}>{w}</span>{' '}
            </>
          ))
        }
      </p>

      <figure class="about__portrait" data-portrait>
        <div class="about__portrait-frame">
          <Picture
            src={about.portrait}
            alt="Portrait of Terry Wu sketching at a desk"
            widths={[360, 560, 760]}
            sizes="(min-width: 1024px) 26vw, (min-width: 700px) 40vw, 80vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            loading="lazy"
            decoding="async"
            class="about__portrait-img"
          />
        </div>
        <figcaption class="about__caption">
          <span>{site.name}</span>
          <span>25.03° N, 121.56° E</span>
        </figcaption>
      </figure>
    </div>

    <div class="about__row">
      <p class="about__body" data-reveal="fade-up">{about.body}</p>
      <ul class="about__stats">
        {
          about.stats.map((s) => (
            <li class="stat" data-reveal="fade-up">
              <span class="stat__value">
                <span>{s.prefix}</span>
                <span data-count={s.value}>{s.value}</span>
                <span>{s.suffix}</span>
              </span>
              <span class="stat__label" set:html={s.label.replace('\n', '<br/>')} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="pillars">
      <p class="label pillars__label" data-reveal="fade-up">
        <span class="label__index">↳</span><span>How I simplify</span>
      </p>
      <ul class="pillars__list">
        {
          about.pillars.map((p, i) => (
            <li class="pillar" data-pillar data-reveal="fade-up">
              <div class="pillar__art" aria-hidden="true">
                {p.key === 'research' && (
                  <svg viewBox="0 0 200 140">
                    {clusters.map((c) => (
                      <circle class="pillar__ring" cx={c.x} cy={c.y} r="25" />
                    ))}
                    {researchDots.map((d) => (
                      <circle
                        class="pillar__dot"
                        r="3"
                        style={`--x0:${d.x0}px;--y0:${d.y0}px;--x1:${d.x1}px;--y1:${d.y1}px;--d:${d.d}s`}
                      />
                    ))}
                  </svg>
                )}
                {p.key === 'systems' && (
                  <svg viewBox="0 0 200 140">
                    <g class="pillar__links">
                      <path d="M72 40 H132 M72 70 H132 M72 100 H132 M72 40 V100 M102 40 V100 M132 40 V100" />
                    </g>
                    {sysBlocks.map((b) => (
                      <rect
                        class="pillar__block"
                        x="-8"
                        y="-8"
                        width="16"
                        height="16"
                        rx="3"
                        style={`--x0:${b.x0}px;--y0:${b.y0}px;--r0:${b.r0}deg;--x1:${b.x1 + 8}px;--y1:${b.y1 + 8}px;--d:${b.d}s`}
                      />
                    ))}
                  </svg>
                )}
                {p.key === 'strategy' && (
                  <svg viewBox="0 0 200 140">
                    <circle class="pillar__target" cx="172" cy="34" r="16" />
                    <circle class="pillar__target" cx="172" cy="34" r="8" />
                    <path
                      class="pillar__scribble"
                      pathLength="1"
                      d="M22 112 C 40 30, 70 132, 88 74 S 128 18, 116 92 S 160 128, 150 66 S 120 40, 172 34"
                    />
                    <path class="pillar__straight" pathLength="1" d="M22 112 L 166 37" />
                    <path class="pillar__head" pathLength="1" d="M152 36 L 167 36 L 160 50" />
                    <circle class="pillar__origin" cx="22" cy="112" r="4" />
                  </svg>
                )}
              </div>
              <div class="pillar__text">
                <span class="pillar__num">0{i + 1}</span>
                <h3 class="pillar__title">{p.title}</h3>
                <p class="pillar__copy">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about__label {
    margin-bottom: clamp(32px, 4vw, 64px);
  }
  .about__grid {
    display: grid;
    gap: clamp(40px, 5vw, 80px);
    align-items: start;
  }
  .about__statement {
    font-size: clamp(30px, 3.9vw, 68px);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }
  .about__statement .w {
    opacity: 0.4;
  }
  :global(.no-js) .about__statement .w {
    opacity: 1;
  }
  .about__statement .serif {
    font-size: 1.08em;
    letter-spacing: -0.02em;
  }

  .about__portrait {
    width: min(100%, 380px);
    justify-self: end;
  }
  .about__portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .about__portrait-frame :global(img) {
    width: 100%;
    height: 118%;
    object-fit: cover;
    transform-origin: 50% 50%;
  }
  .about__portrait-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(241, 241, 241, 0.08);
    pointer-events: none;
  }
  .about__caption {
    display: flex;
    justify-content: space-between;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .about__row {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
    margin-top: clamp(64px, 8vw, 128px);
    padding-top: clamp(32px, 3vw, 48px);
    border-top: 1px solid var(--line);
  }
  .about__body {
    max-width: 46ch;
    font-size: clamp(16px, 1.2vw, 19px);
    color: var(--fg-2);
  }
  .about__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 24px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stat__value {
    display: flex;
    font-size: clamp(44px, 4.6vw, 80px);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat__value span:first-child,
  .stat__value span:last-child {
    color: var(--accent);
  }
  .stat__label {
    font-size: 13px;
    line-height: 1.4;
    color: var(--fg-3);
  }

  /* Pillars */
  .pillars {
    margin-top: clamp(80px, 10vw, 160px);
  }
  .pillars__label {
    margin-bottom: 24px;
  }
  .pillars__list {
    display: grid;
    gap: 16px;
  }
  .pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(26, 24, 35, 0.9), rgba(19, 17, 27, 0.6));
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color 0.5s ease, transform 0.6s var(--ease-out);
  }
  .pillar::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 0%), rgba(111, 91, 255, 0.14), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .pillar:hover {
    border-color: rgba(155, 140, 255, 0.3);
  }
  .pillar:hover::before {
    opacity: 1;
  }
  .pillar__art {
    position: relative;
    aspect-ratio: 200 / 140;
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 20px 20px;
    background-position: center;
    mask-image: radial-gradient(90% 90% at 50% 50%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(90% 90% at 50% 50%, #000 40%, transparent 100%);
  }
  .pillar__art svg {
    position: absolute;
    inset: 8% 6%;
    width: 88%;
    height: 84%;
    overflow: visible;
  }
  .pillar__text {
    display: grid;
    gap: 10px;
    padding: clamp(22px, 2vw, 32px);
  }
  .pillar__num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
  }
  .pillar__title {
    font-size: clamp(22px, 1.8vw, 28px);
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  .pillar__copy {
    color: var(--fg-2);
    font-size: 15px;
    max-width: 38ch;
  }

  /* --- Research diagram --- */
  .pillar__dot {
    fill: var(--fg);
    opacity: 0.75;
    transform: translate(var(--x0), var(--y0));
    transition: transform 1.1s var(--ease-out) var(--d), fill 0.6s ease var(--d);
  }
  .pillar__ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    transition: opacity 0.6s ease, transform 0.9s var(--ease-out);
  }
  .pillar.is-on .pillar__dot {
    transform: translate(var(--x1), var(--y1));
    fill: #d9d3ff;
  }
  .pillar.is-on .pillar__ring {
    opacity: 0.8;
    transform: none;
    transition-delay: 0.55s;
  }

  /* --- Systems diagram --- */
  .pillar__block {
    fill: rgba(241, 241, 241, 0.08);
    stroke: rgba(241, 241, 241, 0.6);
    stroke-width: 1;
    transform: translate(var(--x0), var(--y0)) rotate(var(--r0));
    transition: transform 1.1s var(--ease-out) var(--d), fill 0.6s ease, stroke 0.6s ease;
  }
  .pillar.is-on .pillar__block {
    transform: translate(var(--x1), var(--y1)) rotate(0deg);
    fill: rgba(155, 140, 255, 0.16);
    stroke: var(--accent);
  }
  .pillar__links path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .pillar.is-on .pillar__links path {
    opacity: 0.5;
    transition-delay: 0.7s;
  }

  /* --- Strategy diagram --- */
  .pillar__scribble,
  .pillar__straight,
  .pillar__head {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pillar__scribble {
    stroke: rgba(241, 241, 241, 0.55);
    stroke-width: 1.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1s var(--ease-in-out), opacity 0.6s ease;
  }
  .pillar__straight,
  .pillar__head {
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s var(--ease-out);
  }
  .pillar__target {
    fill: none;
    stroke: rgba(241, 241, 241, 0.3);
    stroke-width: 1;
    transition: stroke 0.6s ease;
  }
  .pillar__origin {
    fill: var(--fg);
  }
  .pillar.is-on .pillar__scribble {
    stroke-dashoffset: -1;
    opacity: 0.25;
  }
  .pillar.is-on .pillar__straight {
    stroke-dashoffset: 0;
    transition-delay: 0.5s;
  }
  .pillar.is-on .pillar__head {
    stroke-dashoffset: 0;
    transition-delay: 1.15s;
  }
  .pillar.is-on .pillar__target {
    stroke: var(--accent);
    transition-delay: 1.2s;
  }

  @media (min-width: 700px) {
    .about__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 900px) {
    .pillars__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: minmax(0, 8fr) minmax(0, 3.4fr);
    }
    .about__portrait {
      margin-top: 0.6em;
    }
    .about__row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }
  }
  @media (max-width: 1023px) {
    .about__portrait {
      justify-self: start;
      width: min(72%, 380px);
    }
  }
</style>
