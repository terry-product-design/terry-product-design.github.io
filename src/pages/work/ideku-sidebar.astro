---
import { getImage } from 'astro:assets';
import Case from '../../layouts/Case.astro';
import CaseHero from '../../components/case/CaseHero.astro';
import Chapter from '../../components/case/Chapter.astro';
import Figure from '../../components/case/Figure.astro';
import NavMaze from '../../components/case/NavMaze.astro';
import Regroup from '../../components/case/Regroup.astro';
import BeforeAfter from '../../components/case/BeforeAfter.astro';
import NextProject from '../../components/case/NextProject.astro';
import { works } from '../../data/content';

import cover from '../../assets/case/ideku-sidebar/cover.png';
import baPosOld from '../../assets/case/ideku-sidebar/ba-pos-old.png';
import baPosNew from '../../assets/case/ideku-sidebar/ba-pos-new.png';
import baIngredientOld from '../../assets/case/ideku-sidebar/ba-ingredient-old.png';
import baIngredientNew from '../../assets/case/ideku-sidebar/ba-ingredient-new.png';
import baStoreOld from '../../assets/case/ideku-sidebar/ba-store-old.png';
import baAddressOld from '../../assets/case/ideku-sidebar/ba-address-old.png';
import baStoreNew from '../../assets/case/ideku-sidebar/ba-store-new.png';
import baStaffOld from '../../assets/case/ideku-sidebar/ba-staff-old.png';
import baStaffNew from '../../assets/case/ideku-sidebar/ba-staff-new.png';
import dashboardOld from '../../assets/case/ideku-sidebar/dashboard-old.png';
import dashboardNew from '../../assets/case/ideku-sidebar/dashboard-new.png';

const index = works.findIndex((w) => w.slug === 'ideku_sidebar');
const next = works[(index + 1) % works.length];

const chapters = [
  { id: 'overview', label: 'Overview' },
  { id: 'problem', label: 'The problem' },
  { id: 'discovery', label: 'Discovery' },
  { id: 'architecture', label: 'Architecture' },
  { id: 'validation', label: 'Validation' },
  { id: 'ship', label: 'Ship' },
  { id: 'reflection', label: 'Reflection' },
];
const pad = (n: number) => String(n).padStart(2, '0');
const num = (id: string) => pad(chapters.findIndex((c) => c.id === id) + 1);
const share = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const wideSizes = '(min-width: 1680px) 1584px, 94vw';

/* ---------- Navigation data (from the before / launched sidebars) ---------- */
const navBefore: [string, string[]?][] = [
  ['Dashboard'],
  ['Menu-V2', ['Custom Menu', 'Category', 'Item List', 'Modifier Master']],
  ['Promotions', ['Promotions', 'Coupons']],
  ['Integration', ['Payment', 'Accounting', 'Delivery', 'IDECONNECT']],
  ['Order & Customer', ['Order', 'Customer']],
  ['Master Data', ['Ingredients Category Master', 'Ingredients Master', 'Unit Master', 'Supplier Master', 'Product Composition']],
  ['Inventory', ['Inventory Overview', 'Stock Card', 'Stock Opname', 'Item Adjustment', 'Stock Transfer']],
  ['Production', ['Quick Production']],
  ['Purchasing', ['Quick Purchase']],
  ['Report'],
  ['Analytic', ['Items', 'Modifier', 'Category', 'Order', 'Shift', 'Payment Reconciliation', 'Promotions']],
  ['Employees', ['Shift', 'Credit']],
  ['IDEKU POS', ['Feature', 'Printer', 'Theme']],
  ['IDEFOOD', ['Appearance', 'Settings']],
  ['IDEKIOSK', ['Appearance', 'Settings']],
  ['IDEQUE', ['Appearance', 'Settings', 'QR Generator']],
  ['Customer Display'],
  ['Queue Number Display'],
  ['KDS/EDS', ['General', 'Display', 'Ticket']],
  ['Branch', ['Store', 'POS Devices']],
  ['Table Management', ['Table Setup', 'QR Generator']],
  ['Log History'],
  ['Setting', ['Info', 'Order Status', 'Operational Hours', 'Scheduled Order', 'Receipt Template', 'Address', 'Additional Fee', 'Pricing Format', 'Tipping Feature']],
  ['User & Permissions', ['User', 'User Role']],
];
const navAfter: [string, string[]?][] = [
  ['Dashboard'],
  ['Menu Management', ['Menu', 'Category', 'Item', 'Modifier']],
  ['Discounts', ['Promotion', 'Coupon']],
  ['Integrations', ['IDECONNECT', 'Delivery', 'Accounting']],
  ['Payments'],
  ['Orders & Customers', ['Order', 'Customer']],
  ['Supply Chain', ['Ingredient', 'Purchasing', 'Inventory', 'Production']],
  ['Reports', ['Sales Summary', 'Stock Movement']],
  ['Analytics', ['Item', 'Modifier', 'Category', 'Order', 'Shift', 'Payment Reconciliation', 'Discount']],
  ['Devices & Sites', ['POS', 'Mini POS', 'QR Ordering', 'Kiosk', 'KDS/EDS', 'Waiting List', 'Queue Number Display']],
  ['Store Settings', ['Store Info', 'Table Management', 'Pricing & Fee', 'Tip', 'Receipt Template', 'Order Status']],
  ['Staff Settings', ['Staff', 'Staff Shift', 'Credit']],
  ['Merchant Settings', ['Business Info', 'Billing & Invoice']],
  ['Log History'],
];
/* ---------- The maze: the four tasks that changed most in testing (starred in the results) ----------
   Same labels and order as the task-by-task chart and the before/after screens.
   The POS route follows the most common wrong path seen in testing; the others are plausible
   first-time paths (retrospective illustration). Stats: direct completions out of 8. */
const mazeTasks = [
  {
    id: 'store',
    label: 'Add a store & address',
    brief: 'Your second store opens next month. Add it — with its address.',
    before: {
      steps: [
        { why: 1, g: 'Branch', c: 'Store', ok: 'part', think: 'A new store… Branch › Store.', note: 'Name, phone, tax number. But there’s no address field.' },
        { why: 2, g: 'Setting', c: 'Info', think: 'An address is info… Setting › Info?', note: 'That’s the business’s details, not this store’s address.' },
        { why: 1, g: 'Setting', c: 'Address', ok: true, think: '…Address. Down here?', note: 'Found — under Setting, with its own store picker. One job, two places.' },
      ],
      stat: 'In testing, **0 of 8** did this without a wrong turn.',
    },
    after: {
      steps: [
        { g: 'Store Settings', c: 'Store Info', ok: true, think: 'Store Settings › Store Info.', note: 'A store’s details and its address are two tabs of the same page.' },
      ],
      stat: 'In testing, **8 of 8** found it directly.',
    },
  },
  {
    id: 'ingredient',
    label: 'Add an ingredient',
    brief: 'Sichuan pepper is going on the menu. Set it up as an ingredient first.',
    before: {
      steps: [
        { why: 1, g: 'Inventory', think: 'Ingredients are stock… Inventory?', note: 'Stock levels and counts — not where ingredients are created.' },
        { why: 1, g: 'Purchasing', c: 'Quick Purchase', think: 'Or where I buy them?', note: 'Purchase orders. Still no ingredient list.' },
        {
          g: 'Master Data',
          c: 'Ingredients Master',
          ok: true,
          why: 3,
          think: '“Master Data”…?',
          note: 'Found — as “Ingredients Master”. And it may need a unit or category first, from two more “Master” pages.',
        },
      ],
      stat: 'In testing, **1 of 8** found it directly.',
    },
    after: {
      steps: [
        {
          g: 'Supply Chain',
          c: 'Ingredient',
          ok: true,
          think: 'Supply Chain › Ingredient.',
          note: 'Categories, units, ingredients and recipes are tabs of one page — next to purchasing, inventory and production.',
        },
      ],
      stat: 'In testing, **6 of 8** found it directly.',
    },
  },
  {
    id: 'staff',
    label: 'Add a staff member',
    brief: 'A new cashier starts tomorrow. Give them a POS login.',
    before: {
      steps: [
        { why: 1, g: 'Employees', think: 'A new employee… “Employees”.', note: 'Shifts and credit only. You can’t add anyone here.' },
        {
          g: 'User & Permissions',
          c: 'User',
          ok: true,
          why: 3,
          think: 'The very last group — “User & Permissions”?',
          note: 'Staff are “users” here, added from the last of 24 groups.',
        },
      ],
      stat: 'In testing, **2 of 8** found it directly.',
    },
    after: {
      steps: [
        { g: 'Staff Settings', c: 'Staff', ok: true, think: 'Staff Settings › Staff.', note: 'Staff and their roles side by side; shifts and credit sit right below.' },
      ],
      stat: 'In testing, **8 of 8** found it directly.',
    },
  },
  {
    // Follows the most common wrong route seen in testing.
    id: 'pos',
    label: 'Add a POS device',
    brief: 'Your second store needs another POS terminal at the counter. Add it to the system.',
    before: {
      steps: [
        { why: 0, g: 'IDEKU POS', c: 'Feature', think: 'A new POS… “IDEKU POS”, obviously.', note: 'Settings for the POS app itself. No way to add a device — dead end.' },
        { why: 2, g: 'Setting', think: 'Maybe adding one is a setting?', note: 'Nine settings. None of them adds a POS.' },
        {
          g: 'Branch',
          c: 'POS Devices',
          ok: true,
          why: 4,
          think: 'Last try: Branch…? “POS Devices”.',
          note: 'Found — under Branch, where a separate form asks for the store and device type again. Kiosks, KDS screens and customer displays are added here too.',
        },
      ],
      stat: 'In testing, **3 of 8** found it directly.',
    },
    after: {
      steps: [
        {
          g: 'Devices & Sites',
          c: 'POS',
          ok: true,
          think: 'Devices & Sites › POS.',
          note: 'The POS list and its customer displays share one page. Adding a POS asks only for a name — the store comes from the page you’re on.',
        },
      ],
      stat: 'In testing, **8 of 8** found it directly.',
    },
  },
];

/* ---------- Why it was a maze: cards under the maze; each flips to its fix on the new sidebar.
   Maze steps point here with `why` (index). ---------- */
const causes = [
  {
    title: 'Named after products, not jobs',
    text: 'IDEKU POS, IDEKIOSK, IDEFOOD, IDEQUE — internal product names. A kiosk was styled in IDEKIOSK but added under Branch › POS Devices.',
    fix: {
      title: 'Grouped by what merchants manage',
      text: 'Devices & Sites, Store Settings, Staff Settings, Supply Chain — one group for each thing a merchant runs.',
    },
  },
  {
    title: 'One job, several places',
    text: 'A store under Branch, its address under Setting. Staff accounts in User & Permissions, their shifts in Employees. The supply chain spread over four groups.',
    fix: {
      title: 'One job, one page',
      text: 'A store’s details and address are tabs of one page — so are staff and roles, suppliers and purchases.',
    },
  },
  {
    title: 'A catch-all “Setting”',
    text: 'Business details, a store’s address, fees, receipts, QR ordering hours, even inventory costing — different jobs and scopes, one drawer.',
    fix: {
      title: 'Every setting in its place',
      text: 'Address into Store Info, inventory costing into Inventory, QR hours into QR Ordering, business details into Merchant Settings.',
    },
  },
  {
    title: 'Words from the system',
    text: '“Ingredients Master”, “Quick Purchase”, “User & Permissions” — vocabulary from the database, not from a restaurant.',
    fix: {
      title: 'Words merchants use',
      text: 'Ingredient, Purchasing, Staff, Store Info. No more “Master” or “Quick”.',
    },
  },
  {
    title: 'Asking again for what it knew',
    text: 'Adding a device opened a separate page that asked for the store and the device type again — every time.',
    fix: {
      title: 'Context carried over',
      text: 'Device pages follow the store picker in the header; adding a POS asks only for a name.',
    },
  },
];

/* ---------- Where everything went ---------- */
const areas = [
  {
    id: 'devices',
    to: 'Devices & Sites',
    tabs: ['POS', 'Mini POS', 'QR Ordering', 'Kiosk', 'KDS/EDS', 'Waiting List', 'Queue Number Display'],
    from: [
      'Branch › POS Devices',
      'IDEKU POS',
      'IDEKIOSK',
      'IDEFOOD',
      'IDEQUE',
      'KDS/EDS',
      'Customer Display',
      'Queue Number Display',
      'Table Management › QR Generator',
      'Setting › Operational Hours',
    ],
    note: 'One page per device type — its list, its add flow and its settings together. Customer displays moved inside POS, the screen they pair with.',
  },
  {
    id: 'store',
    to: 'Store Settings',
    tabs: ['Store Info', 'Table Management', 'Pricing & Fee', 'Tip', 'Receipt Template', 'Order Status'],
    from: [
      'Branch › Store',
      'Setting › Address',
      'Table Management › Table Setup',
      'Setting › Additional Fee',
      'Setting › Pricing Format',
      'Setting › Tipping Feature',
      'Setting › Receipt Template',
      'Setting › Order Status',
    ],
    note: 'Everything about running one store. Details and address are tabs of Store Info; fees and rounding share Pricing & Fee.',
  },
  {
    id: 'staff',
    to: 'Staff Settings',
    tabs: ['Staff', 'Staff Shift', 'Credit'],
    from: ['User & Permissions › User', 'User & Permissions › User Role', 'Employees › Shift', 'Employees › Credit'],
    note: 'Accounts, roles, shifts and credit — one group for the people who work there. Roles became a tab next to the staff list.',
  },
  {
    id: 'supply',
    to: 'Supply Chain',
    tabs: ['Ingredient', 'Purchasing', 'Inventory', 'Production'],
    from: [
      'Master Data › 5 “Master” pages',
      'Purchasing › Quick Purchase',
      'Inventory › 5 pages',
      'Production › Quick Production',
      'Setting › General (inventory cost)',
    ],
    note: 'Ordered like the work: set up ingredients, buy, store, produce. Suppliers sit next to purchases; inventory costing moved into Inventory.',
  },
  {
    id: 'merchant',
    to: 'Merchant Settings',
    tabs: ['Business Info', 'Billing & Invoice'],
    from: ['Setting › Info'],
    note: 'Business-wide details, separated from the settings of each store.',
  },
];

/* ---------- Usability test results (8 participants × 13 tasks per version) ---------- */
const tasks = [
  { t: 'Add store & address', maze: 1, od: 0, or: 5, ot: 99, nd: 8, nr: 0, nt: 32 },
  { t: 'Create menu', od: 7, or: 1, ot: 24, nd: 6, nr: 2, nt: 21 },
  { t: 'Add ingredients', maze: 2, od: 1, or: 3, ot: 80, nd: 6, nr: 0, nt: 47 },
  { t: 'New purchase', od: 6, or: 0, ot: 27, nd: 7, nr: 1, nt: 32 },
  { t: 'Add staff', maze: 3, od: 2, or: 4, ot: 86, nd: 8, nr: 0, nt: 36 },
  { t: 'Add POS device', maze: 4, od: 3, or: 3, ot: 45, nd: 8, nr: 0, nt: 30 },
  { t: 'Add printer', od: 3, or: 3, ot: 42, nd: 6, nr: 1, nt: 26 },
  { t: 'Set up tables', od: 7, or: 1, ot: 45, nd: 8, nr: 0, nt: 30 },
  { t: 'View order', od: 4, or: 3, ot: 58, nd: 6, nr: 1, nt: 16 },
  { t: 'Additional fee', od: 5, or: 1, ot: 25, nd: 5, nr: 1, nt: 19 },
  { t: 'QR ordering: pay later', od: 1, or: 1, ot: 55, nd: 1, nr: 3, nt: 65 },
  { t: 'Operational hours', od: 1, or: 6, ot: 51, nd: 4, nr: 1, nt: 24 },
  { t: 'Create coupon', od: 8, or: 0, ot: 12, nd: 7, nr: 0, nt: 13 },
];
const totals = {
  before: { direct: 48, detour: 31, fail: 25 },
  after: { direct: 80, detour: 10, fail: 14 },
};
const pct = (n: number) => ((n / 104) * 100).toFixed(1);

const competitors = [
  { name: 'IDEKU — before', n: 24, tone: 'before' },
  { name: 'Uber Eats Manager', n: 13 },
  { name: 'foodpanda partner', n: 12 },
  { name: 'Lightspeed', n: 11 },
  { name: 'Square', n: 10 },
  { name: 'IDEKU — launched', n: 14, tone: 'after' },
];

const renames = [
  { from: 'Payment (inside Integration)', to: 'Payments — its own entry' },
  { from: 'Inventory features, scattered', to: 'Consolidated into Supply Chain' },
  { from: 'Materials & Recipes', to: 'Ingredients' },
  { from: 'Device', to: 'Device & Site → Devices & Sites' },
  { from: 'Store', to: 'Store Info' },
];

const handoffs = [
  {
    team: 'Growth / CEX',
    title: 'Tell promotions and coupons apart',
    text: 'Newcomers couldn’t distinguish the two from their labels alone — the difference only became clear after clicking into both.',
    tone: '#e0773a',
  },
  {
    team: 'Addon',
    title: 'Surface supply-chain dependencies',
    text: 'Adding an ingredient could require leaving the flow to create a unit or category first. The dependency wasn’t visible upfront.',
    tone: '#5b3be0',
  },
  {
    team: 'CEX',
    title: 'Bring QR ordering together',
    text: 'QR ordering settings were scattered. Participants expected all QR-related configuration to live in one context.',
    tone: '#3a9bd6',
  },
  {
    team: 'Core / CEX',
    title: 'Clarify what operational hours control',
    text: 'The label read like a store-wide setting, while its actual scope was unclear. People wanted a clearer scope — or control over it.',
    tone: '#3f9b5a',
  },
];
---

<Case
  title="IDEKU — Rebuilding Navigation Around How Merchants Work · Terry Wu"
  description="Case study: restructuring a restaurant SaaS back office from 24 top-level entries to 14, organized by merchant tasks and validated in a comparative usability test."
  image={share.src}
  chapters={chapters}
>
  <CaseHero
    client="IDEKU · Merchant back office"
    title="Rebuilding Navigation Around How Merchants Work"
    intro="A restaurant back office had grown one feature at a time until even long-time staff got lost. I turned a vague complaint into a testable problem — and rebuilt the navigation around the tasks merchants actually do."
    index={index + 1}
    total={works.length}
    meta={[
      { k: 'Role', v: 'Lead designer — research, IA, prototype, testing, UI foundation' },
      { k: 'Team', v: '4 designers · 4 PMs · 4 engineers · 4 QA' },
      { k: 'Timeline', v: '~2 months of design (excluding development)' },
      { k: 'Launch', v: 'September 2026' },
    ]}
    cover={cover}
    coverAlt="The redesigned IDEKU back office on a laptop and tablet, on a café counter"
    coverFull
    stats={[
      { value: 14, prefix: '24 → ', label: 'Top-level navigation entries' },
      { value: 77, prefix: '46 → ', suffix: '%', label: 'Direct task completion (internal test)' },
      { value: 8, suffix: '/8', label: 'Participants preferred the new sidebar' },
      { value: 13, label: 'Real restaurant tasks tested per version' },
    ]}
  />

  <!-- 01 Overview -->
  <Chapter id="overview" num={num('overview')} label="Overview">
    <h2 class="c-h2" data-split-lines>Navigation should follow the <span class="serif">work</span>, not the org chart.</h2>
    <div class="split">
      <div class="stack" data-reveal="fade-up">
        <p class="kicker">The context</p>
        <div class="prose">
          <p>
            IDEKU’s merchant back office covers menus, orders, customers, staff, supply chain, devices and store settings. The goal of the Sidebar Revamp was simple to say and hard to do: <strong>help merchants find the right entry faster</strong>, with categories and names that match how they think about their work.
          </p>
        </div>
      </div>
      <div class="stack" data-reveal="fade-up">
        <p class="kicker">My role</p>
        <div class="prose">
          <p>
            I was the lead designer. I led or ran the research, information architecture, prototype, interviews and usability testing, and defined the <strong>shared layout, components and visual direction</strong>. Three other designers built on that foundation, finalizing feature-level details with their PMs.
          </p>
        </div>
      </div>
    </div>
    <div class="shift" data-reveal="fade-up" aria-label="Shift: from navigation shaped by feature history to navigation shaped by merchant tasks">
      <span class="shift__from">Shaped by feature history</span>
      <span class="shift__arrow" aria-hidden="true"></span>
      <span class="shift__to">Shaped by merchant tasks</span>
    </div>
  </Chapter>

  <!-- 02 Problem -->
  <Chapter id="problem" num={num('problem')} label="The problem">
    <h2 class="c-h2" data-split-lines>It started with a <span class="serif">vague</span> complaint</h2>
    <p class="lead" data-reveal="fade-up">
      There was no research brief — just a customer complaint, relayed by leadership: the navigation is complicated and hard to use.
    </p>
    <div class="prose" data-reveal="fade-up">
      <p>
        The same problem showed up inside the company. Operations and engineering found it hard to use too — even people who had been here <strong>more than six months still opened the wrong entry</strong>. So this wasn’t just a learning curve for newcomers: the entries themselves were hard to predict and hard to remember.
      </p>
      <p>
        The sidebar had grown with the product. Every new feature added an entry or was dropped into an existing group, without a task-based pass over the whole. Over time it came to mirror <strong>internal systems and development history</strong> rather than how merchants work. For a merchant, it was a maze.
      </p>
    </div>

    <div class="stack">
      <p class="kicker" data-reveal="fade-up">Walk it yourself</p>
      <h3 class="c-h3" data-reveal="fade-up">Four everyday jobs. Where do they live?</h3>
      <p class="prose" data-reveal="fade-up">
        Here is the old back office as a map: 24 groups around the root, their entries one click further out. The four jobs are the tasks that changed most in our usability test. Watch someone try one — each wrong turn lights up the reason below the map — or press <strong>Let me try</strong> and find your own way. Switch to the new sidebar to see what changed.
      </p>
    </div>
    <div class="bleed" data-reveal="fade-up">
      <NavMaze before={navBefore} after={navAfter} tasks={mazeTasks} whys={causes} />
    </div>
    <p class="fineprint" data-reveal="fade-up">
      Retrospective illustration, not recordings. The four jobs are the tasks that changed most in the comparative study (chapter {num('validation')}); the POS route follows the most common wrong path seen there, the others are plausible first-time paths. Labels follow the original 24-group and launched 14-group navigation; tests ran on the 12-group test version.
    </p>

    <aside class="callout" data-reveal="fade-up">
      <p class="kicker">Problem statement</p>
      <p class="callout__statement">
        Merchants couldn’t tell, <em>before they started</em>, which entry led to the task they wanted to finish.
      </p>
    </aside>
  </Chapter>

  <!-- 03 Discovery -->
  <Chapter id="discovery" num={num('discovery')} label="Discovery">
    <h2 class="c-h2" data-split-lines>Understand the whole system <span class="serif">first</span></h2>
    <div class="cards cards--3">
      <div class="card-plain" data-reveal="fade-up">
        <span class="card-plain__num">01</span>
        <h3 class="c-h3">Every feature, hands-on</h3>
        <p>I operated every feature myself to understand what it does, where it lives and how it relates to the rest — thinking about the whole back office, not one module.</p>
      </div>
      <div class="card-plain" data-reveal="fade-up">
        <span class="card-plain__num">02</span>
        <h3 class="c-h3">Usage data, read with care</h3>
        <p>Metabase and Google Analytics showed feature usage and task frequency — but frequent use can also mean getting lost, trial and error, or repeated searching.</p>
      </div>
      <div class="card-plain" data-reveal="fade-up">
        <span class="card-plain__num">03</span>
        <h3 class="c-h3">Operations know-how</h3>
        <p>Combining the operations team’s knowledge of merchants’ daily work, I formed mental-model hypotheses to check later in testing.</p>
      </div>
    </div>
    <blockquote data-reveal="fade-up">
      <p class="pull">Data gives behavioral clues. Operations adds task context. But a new IA still has to be <em>proven in use</em>.</p>
    </blockquote>

    <div class="stack">
      <h3 class="c-h3" data-reveal="fade-up">How others draw the line</h3>
      <p class="prose" data-reveal="fade-up">
        I studied Square, Lightspeed, Uber Eats and foodpanda. Their back offices kept top-level navigation to roughly a dozen entries — <strong>a reference for complexity, not a number to copy</strong>. IDEKU’s categories still had to come from its own features, merchant tasks and test results.
      </p>
    </div>
    <figure class="bars" data-inview>
      <figcaption class="bars__title">
        <span class="kicker">Top-level navigation entries</span>
        <span class="bars__note">As observed during research in 2026 — products may have changed since</span>
      </figcaption>
      <ul class="bars__list">
        {
          competitors.map((c, i) => (
            <li class:list={['bars__row', c.tone && `bars__row--${c.tone}`]} style={`--v:${c.n / 24};--i:${i}`}>
              <span class="bars__name">{c.name}</span>
              <span class="bars__track">
                <span class="bars__fill" />
              </span>
              <span class="bars__n">{c.n}</span>
            </li>
          ))
        }
      </ul>
    </figure>
    <p class="prose" data-reveal="fade-up">
      One more observation shaped the proposal: <strong>foodpanda and Uber Eats keep store switching in the sidebar</strong>, so merchants stay in one store’s context while they work. I carried that idea into my first proposal — more on how it played out in the next chapter.
    </p>
  </Chapter>

  <!-- 04 Architecture -->
  <Chapter id="architecture" num={num('architecture')} label="Architecture">
    <h2 class="c-h2" data-split-lines>From 24 entries to <span class="serif">fourteen</span></h2>
    <p class="lead" data-reveal="fade-up">
      I drafted an initial architecture, then worked through it with <strong>each feature’s PM</strong> — where every feature belongs, what each group is called, and how the flows connect.
    </p>
    <div class="cards cards--2">
      <div class="card-plain" data-reveal="fade-up">
        <span class="card-plain__num">01</span>
        <h3 class="c-h3">Group by what merchants manage</h3>
        <p>Devices, stores, staff, the supply chain, the business itself — each became one group. “Where is it?” turns into “What am I working on?”</p>
      </div>
      <div class="card-plain" data-reveal="fade-up">
        <span class="card-plain__num">02</span>
        <h3 class="c-h3">One job, one page</h3>
        <p>A feature’s list, its add flow and its settings sit on one page as tabs: a kiosk’s list, appearance and settings; staff and their roles; suppliers and purchases; a store’s details and address.</p>
      </div>
      <div class="card-plain" data-reveal="fade-up">
        <span class="card-plain__num">03</span>
        <h3 class="c-h3">Every setting in its place</h3>
        <p>The catch-all Setting was emptied into the areas it served. Each area also got a clear scope: the supply chain is managed across the business, while store settings and devices follow the store picked in the header.</p>
      </div>
      <div class="card-plain" data-reveal="fade-up">
        <span class="card-plain__num">04</span>
        <h3 class="c-h3">Plain words, fewer layers</h3>
        <p>No more “Master” or “Quick”; single-entry groups were flattened. Entry count is a structural signal — whether things got easier to find still had to be tested.</p>
      </div>
    </div>

    <div class="stack">
      <p class="kicker" data-reveal="fade-up">Where everything went</p>
      <h3 class="c-h3" data-reveal="fade-up">Scattered entries, one home each</h3>
    </div>
    <div class="bleed" data-reveal="fade-up">
      <Regroup areas={areas} />
    </div>
    <p class="fineprint" data-reveal="fade-up">
      Retrospective summary: old locations from the original back office, new groups from the launched navigation.
    </p>

    <div class="stack">
      <h3 class="c-h3" data-reveal="fade-up">The trade-off: keeping merchants in one store</h3>
      <p class="prose" data-reveal="fade-up">
        Inspired by foodpanda and Uber Eats, I wanted a <strong>store switcher in the sidebar</strong>, so merchants pick a store once and every feature stays in it. It required extra engineering, and the PMs had a timeline to protect — so it didn’t make this release.
      </p>
    </div>
    <div class="tradeoff" data-reveal="fade-up">
      <div class="tradeoff__col">
        <p class="kicker">Proposed</p>
        <h4>A store switcher in the sidebar</h4>
        <p>Pick a store once; every feature stays in that store’s context.</p>
        <span class="tradeoff__tag tradeoff__tag--off">Not in this release</span>
      </div>
      <span class="tradeoff__arrow" aria-hidden="true"></span>
      <div class="tradeoff__col tradeoff__col--on">
        <p class="kicker">Shipped</p>
        <h4>Pages that follow the store picker</h4>
        <p>The header already had a store picker, but the old Branch pages didn’t show it. Device pages now follow it — adding a POS records it to the selected store instead of asking again.</p>
        <span class="tradeoff__tag">Smaller scope, part of the benefit</span>
      </div>
    </div>

    <div class="forms" data-reveal="fade-up">
      <figure class="form">
        <figcaption>
          <span class="kicker form__k--old">Before</span>
          <span>Branch › POS Devices › Add Device — a separate page</span>
        </figcaption>
        <div class="ui" aria-hidden="true">
          <div class="ui__top"><span class="ui__title">Add Device</span></div>
          <div class="ui__page">
            <div class="ui__card">
              <div class="ui__f"><span>Device name</span><i class="ui__in">Counter 2</i></div>
              <div class="ui__f ui__f--ask"><span>Store</span><i class="ui__in ui__in--sel">Select store</i><b>again</b></div>
              <div class="ui__f ui__f--ask"><span>Type</span><i class="ui__in ui__in--sel">POS</i><b>again</b></div>
              <div class="ui__f"><span>Status</span><i class="ui__status">Offline</i></div>
              <div class="ui__btns"><i>Cancel</i><i class="is-primary">Save</i></div>
            </div>
          </div>
        </div>
        <p class="form__note">Four fields on a new page — including the store and device type you’d already chosen.</p>
      </figure>
      <figure class="form">
        <figcaption>
          <span class="kicker">After</span>
          <span>Devices &amp; Sites › POS › Add POS — a modal on the list</span>
        </figcaption>
        <div class="ui" aria-hidden="true">
          <div class="ui__top"><span class="ui__store">Main Street store<em>▾</em></span></div>
          <div class="ui__page ui__page--list">
            <div class="ui__rows"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="ui__modal">
              <span class="ui__title">Add POS</span>
              <div class="ui__f"><span>Name</span><i class="ui__in">Counter 2</i></div>
              <div class="ui__btns"><i>Cancel</i><i class="is-primary">Create</i></div>
            </div>
          </div>
        </div>
        <p class="form__note">One field. The store comes from the picker in the header; the type from the page you’re on.</p>
      </figure>
    </div>
    <p class="fineprint" data-reveal="fade-up">Simplified recreation of the two flows.</p>

    <div class="stack">
      <h3 class="c-h3" data-reveal="fade-up">What we chose not to touch</h3>
      <p class="prose" data-reveal="fade-up">
        Purchasing, stock transfers and item adjustments carry complex logic. They moved into Supply Chain, but their flows stayed exactly as they were. The revamp changed <strong>where things live, not how these features work</strong> — which kept the risk inside the timeline.
      </p>
    </div>
  </Chapter>

  <!-- 05 Validation -->
  <Chapter id="validation" num={num('validation')} label="Validation">
    <h2 class="c-h2" data-split-lines>Testing habits <span class="serif">and</span> first impressions</h2>
    <p class="lead" data-reveal="fade-up">
      A comparative usability test, designed to check two things at once: whether experienced users would adapt, and whether newcomers would understand it on first sight.
    </p>
    <div class="setup">
      <div class="setup__item" data-reveal="fade-up">
        <span class="setup__big">4 + 4</span>
        <p><strong>Participants:</strong> 8 internal colleagues outside the development team — 4 familiar with IDEKU, 4 new to it.</p>
      </div>
      <div class="setup__item" data-reveal="fade-up">
        <span class="setup__big">2 × 13</span>
        <p><strong>Tasks:</strong> everyone ran 13 restaurant-owner tasks on both sidebars, thinking aloud on a working prototype.</p>
      </div>
      <div class="setup__item" data-reveal="fade-up">
        <span class="setup__big">50 / 50</span>
        <p><strong>Counterbalanced:</strong> half started with the old sidebar, half with the new, to reduce order and learning effects.</p>
      </div>
      <div class="setup__item" data-reveal="fade-up">
        <span class="setup__big">104</span>
        <p><strong>Attempts per version:</strong> 8 participants × 13 tasks — repeated attempts, not 104 different people.</p>
      </div>
    </div>
    <blockquote class="scenario" data-reveal="fade-up">
      <p class="kicker">The opening story, read to every participant</p>
      <p>
        “Imagine you’ve just opened a small mala xiang guo restaurant in a busy neighborhood… you’re now the one running the whole back office — managing the menu, tracking ingredients, setting up devices, hiring staff, running promotions, and checking sales every day.”
      </p>
    </blockquote>

    <ul class="measures">
      <li data-reveal="fade-up">
        <svg viewBox="0 0 120 24" aria-hidden="true"><path d="M4 12 H104" /><circle cx="110" cy="12" r="8" class="m-ok" /></svg>
        <h3>Direct completion</h3>
        <p>Reached the correct entry on the first attempt, without clicking into a wrong one.</p>
      </li>
      <li data-reveal="fade-up">
        <svg viewBox="0 0 120 24" aria-hidden="true"><path d="M4 12 L34 18 L62 6 L104 12" /><circle cx="34" cy="18" r="3" /><circle cx="62" cy="6" r="3" /><circle cx="110" cy="12" r="8" class="m-detour" /></svg>
        <h3>Detour completion</h3>
        <p>Got there eventually, after at least one wrong entry.</p>
      </li>
      <li data-reveal="fade-up">
        <svg viewBox="0 0 120 24" aria-hidden="true"><path d="M4 12 H104" stroke-dasharray="4 5" /><circle cx="110" cy="12" r="8" class="m-fail" /></svg>
        <h3>Fail</h3>
        <p>Didn’t find the path within the task window, or gave up.</p>
      </li>
    </ul>
    <p class="fineprint" data-reveal="fade-up">
      Also recorded: completion time (successful attempts only), a 1–10 ease-of-use rating per version (not SUS), and an overall preference.
    </p>

    <!-- Results -->
    <div class="headline" data-reveal="fade-up">
      <span class="headline__num"><span class="headline__from">46%</span><span class="headline__arrow" aria-label="to">→</span>77%</span>
      <p>
        <strong>Direct completion</strong> rose from 48 to 80 of 104 attempts — about <strong>+31 percentage points</strong>. Including detours, overall completion went from 76% to 87%, and failures dropped from 25 to 14.
      </p>
    </div>

    <figure class="stack-bars" data-inview>
      <figcaption class="stack-bars__legend">
        <span class="lg lg--direct">Direct</span>
        <span class="lg lg--detour">Detour</span>
        <span class="lg lg--fail">Fail</span>
        <span class="stack-bars__of">of 104 attempts</span>
      </figcaption>
      {
        (['before', 'after'] as const).map((side) => (
          <div class="sb-row">
            <span class="sb-row__name">{side === 'before' ? 'Old sidebar' : 'New sidebar'}</span>
            <span class="sb-row__bar">
              <span class="sb sb--direct" style={`--w:${pct(totals[side].direct)}%`}>
                {totals[side].direct}
              </span>
              <span class="sb sb--detour" style={`--w:${pct(totals[side].detour)}%`}>
                {totals[side].detour}
              </span>
              <span class="sb sb--fail" style={`--w:${pct(totals[side].fail)}%`}>
                {totals[side].fail}
              </span>
            </span>
          </div>
        ))
      }
    </figure>

    <div class="ratings">
      <div class="rating" data-inview>
        <p class="kicker">Familiar users · ease of use</p>
        <div class="rating__scale">
          <span class="rating__dot rating__dot--old" style="--x:0.53"><b>5.3</b></span>
          <span class="rating__dot rating__dot--new" style="--x:0.74"><b>7.4</b></span>
          <span class="rating__line" style="--a:0.53;--b:0.74"></span>
        </div>
        <p class="rating__obs">“Store Setup” read like a pre-opening checklist — easier to navigate intuitively.</p>
      </div>
      <div class="rating" data-inview>
        <p class="kicker">New users · ease of use</p>
        <div class="rating__scale">
          <span class="rating__dot rating__dot--old" style="--x:0.44"><b>4.4</b></span>
          <span class="rating__dot rating__dot--new" style="--x:0.8"><b>8.0</b></span>
          <span class="rating__line" style="--a:0.44;--b:0.8"></span>
        </div>
        <p class="rating__obs">On the old sidebar, some said they’d rather skip a setting entirely than keep searching. On the new one, they stopped guessing and started completing.</p>
      </div>
    </div>
    <p class="prefer" data-reveal="fade-up"><span>8 / 8</span> participants preferred the new sidebar.</p>

    <div class="stack">
      <h3 class="c-h3" data-reveal="fade-up">Task by task</h3>
      <p class="prose" data-reveal="fade-up">
        The biggest gains came on the four jobs from the maze (marked 01–04) — the entries that had been hardest to predict. <strong>Store &amp; address went from 0/8 to 8/8</strong> direct completions; staff from 2/8 and POS from 3/8 to 8/8; ingredients from 1/8 to 6/8.
      </p>
    </div>
    <figure class="dumb" data-inview>
      <figcaption class="dumb__legend">
        <span class="lg lg--old">Old</span>
        <span class="lg lg--new">New</span>
        <span class="lg lg--maze">Jobs from the maze</span>
        <span class="dumb__axis-note">Direct completions out of 8<span class="dumb__time-note"> · avg. time of successful attempts</span></span>
      </figcaption>
      <div class="dumb__axis" aria-hidden="true">
        <span></span>
        <span class="dumb__ticks">{Array.from({ length: 9 }, (_, i) => <i style={`--x:${i / 8}`}>{i}</i>)}</span>
        <span></span>
        <span></span>
      </div>
      <ul class="dumb__rows">
        {
          tasks.map((r, i) => {
            const dir = r.nd > r.od ? 'up' : r.nd < r.od ? 'down' : 'flat';
            return (
              <li class:list={['dumb__row', `dumb__row--${dir}`, { 'dumb__row--maze': r.maze }]} style={`--i:${i}`}>
                <span class="dumb__name">
                  {r.maze && <b class="dumb__tag" title="One of the four jobs from the maze">{pad(r.maze)}</b>}
                  {r.t}
                </span>
                <span class="dumb__track">
                  <span class="dumb__seg" style={`--a:${Math.min(r.od, r.nd) / 8};--b:${Math.max(r.od, r.nd) / 8}`} />
                  <span class="dumb__dot dumb__dot--old" style={`--x:${r.od / 8}`} title={`Old: ${r.od}/8`} />
                  <span class="dumb__dot dumb__dot--new" style={`--x:${r.nd / 8}`} title={`New: ${r.nd}/8`} />
                </span>
                <span class="dumb__vals">
                  {r.od} → <b>{r.nd}</b>
                </span>
                <span class="dumb__time">
                  {r.ot}s → {r.nt}s
                </span>
              </li>
            );
          })
        }
      </ul>
    </figure>

    <div class="split">
      <div class="stack" data-reveal="fade-up">
        <p class="kicker">Not everything got better</p>
        <ol class="nlist">
          <li><span>01</span><span><strong>Create menu</strong> — fewer direct completions and more detours, though all 8 still finished.</span></li>
          <li><span>02</span><span><strong>New purchase</strong> — more successes, but a longer average time.</span></li>
          <li><span>03</span><span><strong>QR ordering: pay later</strong> — direct completion stayed at 1/8 and took longer.</span></li>
          <li><span>04</span><span><strong>Operational hours</strong> — more direct completions, but total successes fell from 7 to 5.</span></li>
          <li><span>05</span><span><strong>Create coupon</strong> — 8/8 to 7/8, slightly slower.</span></li>
        </ol>
      </div>
      <div class="stack" data-reveal="fade-up">
        <p class="kicker">What the results support</p>
        <div class="prose">
          <p>
            In this internal comparison, people found the right entry directly far more often. Reorganizing navigation improves how findable an entry is — but <strong>categories and names can’t fix every problem inside a feature’s own flow</strong>.
          </p>
          <p>
            Participants were colleagues, not merchants, and no significance testing was run. Average times compare different sets of successful attempts, so I treat them as a secondary signal.
          </p>
        </div>
      </div>
    </div>
  </Chapter>

  <!-- 06 Ship -->
  <Chapter id="ship" num={num('ship')} label="Ship">
    <h2 class="c-h2" data-split-lines>Iterate, hand off, <span class="serif">launch</span></h2>
    <p class="lead" data-reveal="fade-up">
      Findings went straight back into the navigation. Naming fixes shipped with the new sidebar; problems beyond navigation went to the teams that own them.
    </p>
    <ul class="renames" data-reveal="fade-up">
      {
        renames.map((r) => (
          <li>
            <span class="renames__from">{r.from}</span>
            <span class="renames__arrow" aria-hidden="true" />
            <span class="renames__to">{r.to}</span>
          </li>
        ))
      }
    </ul>
    <p class="fineprint" data-reveal="fade-up">
      Names kept evolving after the study — the proposed “Marketing” group shipped as Discounts, and Store Setup as Store Settings.
    </p>

    <div class="stack">
      <h3 class="c-h3" data-reveal="fade-up">The four jobs, before and after</h3>
      <p class="prose" data-reveal="fade-up">
        The same four jobs from the maze, now in the real screens of the old back office and the launched one. Look at the left edge: the sidebar tells you where you are.
      </p>
    </div>
    <div class="bleed" data-reveal="fade-up">
      <BeforeAfter
        items={[
          {
            id: 'store',
            label: 'Add a store & address',
            before: [
              { src: baStoreOld, alt: 'Old back office: store details under Branch', crumb: ['Branch', 'Store'] },
              { src: baAddressOld, alt: 'Old back office: the address, separately under Setting', crumb: ['Setting', 'Address'] },
            ],
            after: { src: baStoreNew, alt: 'Launched back office: store details and address together under Store Settings', crumb: ['Store Settings', 'Store Info'] },
            stat: 'Direct completion in testing — 0/8 → 8/8',
          },
          {
            id: 'ingredient',
            label: 'Add an ingredient',
            before: [{ src: baIngredientOld, alt: 'Old back office: Ingredients Category Master under Master Data', crumb: ['Master Data', 'Ingredients Category Master'] }],
            after: { src: baIngredientNew, alt: 'Launched back office: Ingredient under Supply Chain', crumb: ['Supply Chain', 'Ingredient'] },
            stat: 'Direct completion in testing — 1/8 → 6/8',
          },
          {
            id: 'staff',
            label: 'Add a staff member',
            before: [{ src: baStaffOld, alt: 'Old back office: staff managed as users under User & Permissions', crumb: ['User & Permissions', 'User'] }],
            after: { src: baStaffNew, alt: 'Launched back office: Staff under Staff Settings', crumb: ['Staff Settings', 'Staff'] },
            stat: 'Direct completion in testing — 2/8 → 8/8',
          },
          {
            id: 'pos',
            label: 'Add a POS device',
            before: [{ src: baPosOld, alt: 'Old back office: POS devices under Branch', crumb: ['Branch', 'POS Devices'] }],
            after: { src: baPosNew, alt: 'Launched back office: POS under Devices & Sites', crumb: ['Devices & Sites', 'POS'] },
            stat: 'Direct completion in testing — 3/8 → 8/8',
          },
        ]}
      />
    </div>
    <p class="fineprint" data-reveal="fade-up">Personal names and emails in the old screenshots are blurred.</p>

    <div class="stack">
      <h3 class="c-h3" data-reveal="fade-up">Beyond the sidebar</h3>
      <p class="prose" data-reveal="fade-up">
        Some friction lived inside features, not in the navigation. The study mapped each one to the team that owns it — follow-up directions, not finished work.
      </p>
    </div>
    <ul class="handoffs">
      {
        handoffs.map((h) => (
          <li style={`--tone:${h.tone}`} data-reveal="fade-up">
            <span class="handoffs__team">{h.team}</span>
            <h4>{h.title}</h4>
            <p>{h.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="stack">
      <h3 class="c-h3" data-reveal="fade-up">A foundation others could build on</h3>
      <p class="prose" data-reveal="fade-up">
        I defined the shared layout, components and visual direction first. The three other designers then worked with their feature PMs on the details — for example, whether creating something should open a new page or a modal. That split let me guard consistency across features while the people closest to each module refined it.
      </p>
    </div>
    <div class="split bleed">
      <Figure src={dashboardOld} alt="The previous IDEKU dashboard with the old sidebar" caption="Before" sizes="(min-width: 900px) 46vw, 92vw" widths={[600, 1000, 1410]} zoom />
      <Figure src={dashboardNew} alt="The redesigned IDEKU dashboard with the new sidebar" caption="After — new sidebar, color system and type scale" sizes="(min-width: 900px) 46vw, 92vw" widths={[600, 1000, 1600, 2880]} zoom />
    </div>
    <p class="fineprint" data-reveal="fade-up">
      On the dashboard itself, the update covered the sidebar, color system and type scale — the main content layout wasn’t redesigned.
    </p>

    <ol class="timeline" data-inview>
      <li><span class="timeline__when">Spring 2026</span><span class="timeline__what">Discovery, IA and prototype with feature PMs</span></li>
      <li><span class="timeline__when">Jun 1 – 22</span><span class="timeline__what">Comparative usability testing</span></li>
      <li><span class="timeline__when">Jun 26 – Jul 2</span><span class="timeline__what">Design iteration from findings</span></li>
      <li><span class="timeline__when">Jul 6</span><span class="timeline__what">Development kickoff</span></li>
      <li class="is-launch"><span class="timeline__when">Sep 2026</span><span class="timeline__what">Launched</span></li>
    </ol>
  </Chapter>

  <!-- 07 Reflection -->
  <Chapter id="reflection" num={num('reflection')} label="Reflection">
    <h2 class="c-h2" data-split-lines>Navigation is never <span class="serif">done</span></h2>
    <p class="lead" data-reveal="fade-up">
      The new sidebar launched in September 2026, and leadership was happy with the result. I don’t have access to post-launch analytics, so the numbers here come from the internal test — not production.
    </p>
    <div class="prose" data-reveal="fade-up">
      <p>
        The project taught me that navigation keeps absorbing new features. A clean first version is only the start: if every team adds its own categories again, the original problem comes back. If I continue this work, I’d propose turning a few questions into shared rules:
      </p>
    </div>
    <ol class="nlist" data-reveal="fade-up">
      <li><span>01</span><span>When does a feature deserve a new <strong>top-level entry</strong>?</span></li>
      <li><span>02</span><span>Does the name use <strong>words merchants actually use</strong>?</span></li>
      <li><span>03</span><span>Can it fit an <strong>existing, sensible task group</strong> instead?</span></li>
      <li><span>04</span><span>Who reviews <strong>cross-module navigation changes</strong> together?</span></li>
      <li><span>05</span><span>How do we keep measuring <strong>wrong turns, abandonment and completion</strong> with real merchants?</span></li>
    </ol>
    <p class="fineprint" data-reveal="fade-up">These are recommendations, not an established process.</p>

    <blockquote class="testimonial" data-reveal="fade-up">
      <p class="pull">My biggest contribution: turning a vague complaint into <em>a product problem we could test</em>.</p>
      <p class="prose">
        Understand the whole system, propose a structure, align with every feature team, validate it with a comparative test — and ship within the timeline, with clear owners for what comes next.
      </p>
    </blockquote>
  </Chapter>

  <NextProject client={next.client} title={next.title} image={next.image} href={next.href} accent={next.accent} />
</Case>

