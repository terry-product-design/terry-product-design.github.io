    color: var(--fg-2);
  }
  .bars__track {
    height: 10px;
    border-radius: 5px;
    background: rgba(241, 241, 241, 0.05);
    overflow: hidden;
  }
  .bars__fill {
    display: block;
    height: 100%;
    width: calc(var(--v) * 100%);
    border-radius: inherit;
    background: rgba(241, 241, 241, 0.32);
    transform-origin: 0 50%;
    transform: scaleX(0);
    transition: transform 1.1s var(--ease-out) calc(var(--i) * 0.08s);
  }
  .bars.is-on .bars__fill {
    transform: none;
  }
  .bars__n {
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--fg);
  }
  .bars__row--before .bars__fill {
    background: #e5484d;
  }
  .bars__row--before .bars__name,
  .bars__row--before .bars__n {
    color: #ff9a9d;
  }
  .bars__row--after .bars__fill {
    background: var(--accent);
  }
  .bars__row--after .bars__name,
  .bars__row--after .bars__n {
    color: var(--accent);
  }

  /* ---------- Trade-off ---------- */
  .tradeoff {
    display: grid;
    gap: 16px;
    align-items: stretch;
  }
  .tradeoff__col {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: clamp(22px, 2.4vw, 34px);
    border-radius: var(--radius);
    border: 1px dashed var(--line-strong);
    color: var(--fg-2);
  }
  .tradeoff__col h4 {
    font-size: clamp(21px, 1.8vw, 28px);
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--fg-2);
  }
  .tradeoff__col--on {
    border: 1px solid rgba(155, 140, 255, 0.45);
    background: rgba(111, 91, 255, 0.08);
    color: var(--fg);
  }
  .tradeoff__col--on h4 {
    color: var(--fg);
  }
  .tradeoff__tag {
    justify-self: start;
    margin-top: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--accent-2);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
  }
  .tradeoff__tag--off {
    background: rgba(241, 241, 241, 0.08);
    color: var(--fg-3);
  }
  .tradeoff__arrow {
    position: relative;
    align-self: center;
    justify-self: center;
    width: 1px;
    height: 32px;
    background: linear-gradient(var(--line-strong), var(--accent));
  }
  @media (min-width: 900px) {
    .tradeoff {
      grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1fr);
    }
    .tradeoff__arrow {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, var(--line-strong), var(--accent));
    }
  }

  /* ---------- Trade-off: add-device forms, before and after (simplified recreation) ---------- */
  .forms {
    display: grid;
    gap: 16px;
  }
  /* Caption, mock and note share rows across both figures, so the mocks line up and match heights */
  .form {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 14px;
    margin: 0;
  }
  .form figcaption {
    display: grid;
    gap: 6px;
    font-size: 14px;
    color: var(--fg-2);
  }
  .form__k--old {
    color: #ff9a9d;
  }
  .form__note {
    font-size: 15px;
    color: var(--fg-2);
  }
  .ui {
    --ui-red: #8f1d2c;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 340px;
    border-radius: calc(var(--radius) * 0.75);
    overflow: hidden;
    background: #f2f1f5;
    color: #2a2730;
    font-size: 12px;
    box-shadow: 0 0 0 1px var(--line-strong), 0 30px 70px rgba(0, 0, 0, 0.4);
  }
  .ui__top {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    background: #fff;
    border-bottom: 1px solid #e6e4ea;
  }
  .ui__title {
    font-size: 14px;
    font-weight: 500;
  }
  .ui__store {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1.5px solid var(--accent-2);
    box-shadow: 0 0 0 4px rgba(111, 91, 255, 0.18);
    font-size: 12px;
  }
  .ui__store em {
    font-style: normal;
    color: #8a8592;
  }
  .ui__page {
    position: relative;
    padding: 16px 18px;
  }
  .ui__card,
  .ui__modal {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 16px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(20, 10, 30, 0.08);
  }
  .ui__card {
    width: min(100%, 300px);
  }
  .ui__f {
    position: relative;
    display: grid;
    gap: 4px;
    font-size: 11px;
    color: #6b6672;
  }
  .ui__in {
    display: block;
    padding: 7px 9px;
    border-radius: 5px;
    border: 1px solid #dcd9e1;
    font-style: normal;
    font-size: 12px;
    color: #2a2730;
  }
  .ui__in--sel::after {
    content: '▾';
    float: right;
    color: #8a8592;
  }
  .ui__f--ask .ui__in {
    border: 1.5px dashed #e5484d;
    background: #fff4f4;
  }
  .ui__f b {
    position: absolute;
    right: -8px;
    top: 0;
    padding: 1px 7px;
    border-radius: 999px;
    background: #e5484d;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  .ui__status {
    font-style: normal;
    font-size: 12px;
    color: #2a2730;
  }
  .ui__status::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 50%;
    background: #c4323c;
  }
  .ui__btns {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 4px;
  }
  .ui__btns i {
    padding: 5px 12px;
    border-radius: 5px;
    border: 1px solid var(--ui-red);
    font-style: normal;
    font-size: 11px;
    color: var(--ui-red);
  }
  .ui__btns i.is-primary {
    background: var(--ui-red);
    color: #fff;
  }
  .ui__rows {
    display: grid;
    gap: 8px;
  }
  .ui__rows i {
    height: 18px;
    border-radius: 4px;
    background: #fff;
  }
  .ui__rows i:first-child {
    background: var(--ui-red);
    opacity: 0.85;
  }
  .ui__page--list::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(30, 24, 40, 0.38);
  }
  .ui__modal {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    width: min(78%, 260px);
    transform: translate(-50%, -50%);
    box-shadow: 0 20px 50px rgba(20, 10, 30, 0.35);
  }
  @media (min-width: 900px) {
    .forms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Validation ---------- */
  .setup {
    display: grid;
    gap: 14px;
  }
  .setup__item {
    display: grid;
    gap: 10px;
    padding: clamp(20px, 2.2vw, 30px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(26, 24, 35, 0.9), rgba(19, 17, 27, 0.6));
    color: var(--fg-2);
    font-size: 15px;
    line-height: 1.5;
  }
  .setup__item strong {
    font-weight: 400;
    color: var(--fg);
  }
  .setup__big {
    font-size: clamp(36px, 3.4vw, 56px);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--fg);
  }
  @media (min-width: 700px) {
    .setup {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .setup {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .scenario {
    display: grid;
    gap: 14px;
    padding-left: clamp(20px, 3vw, 40px);
    border-left: 1px solid var(--accent);
  }
  .scenario p:last-child {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 2vw, 32px);
    line-height: 1.25;
    max-width: 40ch;
  }

  .measures {
    display: grid;
    gap: 14px;
  }
  .measures li {
    display: grid;
    gap: 10px;
    padding: clamp(20px, 2.2vw, 30px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .measures svg {
    width: 140px;
    height: 28px;
    fill: var(--fg);
    stroke: var(--fg-2);
    stroke-width: 1.2;
    overflow: visible;
  }
  .measures svg path {
    fill: none;
  }
  .measures .m-ok {
    fill: #4ade80;
    stroke: none;
  }
  .measures .m-detour {
    fill: #f6c27a;
    stroke: none;
  }
  .measures .m-fail {
    fill: #e5484d;
    stroke: none;
  }
  .measures h3 {
    font-size: 20px;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .measures p {
    color: var(--fg-2);
    font-size: 15px;
  }
  @media (min-width: 900px) {
    .measures {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .headline {
    display: grid;
    gap: 18px;
    align-items: end;
    padding-top: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--line);
  }
  .headline__num {
    display: flex;
    align-items: baseline;
    gap: 0.12em;
    font-size: clamp(64px, 9vw, 160px);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .headline__from {
    font-size: 0.5em;
    color: var(--fg-3);
  }
  .headline__arrow {
    font-size: 0.35em;
    color: var(--accent);
    align-self: center;
  }
  .headline p {
    color: var(--fg-2);
    max-width: 46ch;
  }
  .headline strong {
    font-weight: 400;
    color: var(--fg);
  }
  @media (min-width: 1024px) {
    .headline {
      grid-template-columns: auto minmax(0, 1fr);
      gap: clamp(32px, 4vw, 64px);
    }
  }

  .lg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--fg-2);
  }
  .lg::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: currentColor;
  }
  .lg--direct::before {
    background: #4ade80;
  }
  .lg--detour::before {
    background: #f6c27a;
  }
  .lg--fail::before {
    background: #e5484d;
  }
  .lg--old::before {
    border-radius: 50%;
    background: #8d8a96;
  }
  .lg--new::before {
    border-radius: 50%;
    background: var(--accent);
  }
  .lg--maze::before {
    width: 18px;
    border-radius: 4px;
    background: rgba(111, 91, 255, 0.35);
    box-shadow: inset 0 0 0 1px rgba(155, 140, 255, 0.6);
  }

  .stack-bars {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: clamp(22px, 3vw, 44px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, #13111b, #0e0b17);
  }
  .stack-bars__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }
  .stack-bars__of {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-3);
  }
  .sb-row {
    display: grid;
    gap: 8px;
  }
  .sb-row__name {
    font-size: 14px;
    color: var(--fg-2);
  }
  .sb-row__bar {
    display: flex;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(241, 241, 241, 0.04);
  }
  .sb {
    display: grid;
    place-items: center;
    width: 0;
    font-size: 14px;
    font-weight: 500;
    color: #0b0912;
    font-variant-numeric: tabular-nums;
    transition: width 1.3s var(--ease-out);
  }
  .stack-bars.is-on .sb {
    width: var(--w);
  }
  .sb--direct {
    background: #4ade80;
  }
  .sb--detour {
    background: #f6c27a;
    transition-delay: 0.15s;
  }
  .sb--fail {
    background: #e5484d;
    color: #fff;
    transition-delay: 0.3s;
  }
  @media (min-width: 700px) {
    .sb-row {
      grid-template-columns: 130px minmax(0, 1fr);
      align-items: center;
    }
  }

  .ratings {
    display: grid;
    gap: 14px;
  }
  .rating {
    display: grid;
    gap: 22px;
    padding: clamp(22px, 2.6vw, 36px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(26, 24, 35, 0.9), rgba(19, 17, 27, 0.6));
  }
  .rating__scale {
    position: relative;
    height: 56px;
    margin: 0 18px;
    border-bottom: 1px solid var(--line-strong);
  }
  .rating__line {
    position: absolute;
    bottom: 13px;
    left: calc(var(--a) * 100%);
    width: calc((var(--b) - var(--a)) * 100%);
    height: 2px;
    background: linear-gradient(90deg, #8d8a96, var(--accent));
    transform-origin: 0 50%;
    transform: scaleX(0);
    transition: transform 1.1s var(--ease-out) 0.2s;
  }
  .rating__dot {
    position: absolute;
    bottom: 8px;
    left: calc(var(--x) * 100%);
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    z-index: 1;
  }
  .rating__dot b {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 22px;
    font-weight: 300;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .rating__dot--old {
    background: #8d8a96;
  }
  .rating__dot--old b {
    color: var(--fg-3);
  }
  .rating__dot--new {
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.4s ease 1s;
  }
  .rating__dot--new b {
    color: var(--accent);
  }
  .rating.is-on .rating__line {
    transform: none;
  }
  .rating.is-on .rating__dot--new {
    opacity: 1;
  }
  .rating__obs {
    color: var(--fg-2);
    font-size: 15px;
  }
  @media (min-width: 900px) {
    .ratings {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .prefer {
    font-size: clamp(22px, 2vw, 32px);
    letter-spacing: -0.02em;
  }
  .prefer span {
    color: var(--accent);
  }

  /* Dumbbell chart */
  .dumb {
    --name: minmax(120px, 0.34fr);
    display: grid;
    gap: 6px;
    margin: 0;
    padding: clamp(18px, 3vw, 44px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, #13111b, #0e0b17);
    overflow-x: auto;
  }
  .dumb__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-bottom: 10px;
  }
  .dumb__axis-note {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-3);
  }
  .dumb__axis,
  .dumb__row {
    display: grid;
    grid-template-columns: var(--name) minmax(180px, 1fr) 64px 92px;
    gap: 16px;
    align-items: center;
    min-width: 560px;
  }
  .dumb__ticks {
    position: relative;
    height: 16px;
    margin: 0 7px;
  }
  .dumb__ticks i {
    position: absolute;
    left: calc(var(--x) * 100%);
    transform: translateX(-50%);
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--fg-3);
  }
  .dumb__rows {
    display: grid;
  }
  .dumb__row {
    padding: 9px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .dumb__name {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-2);
  }
  /* The four jobs walked through in the maze (chapter 02) */
  .dumb__row--maze {
    margin: 0 -10px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    background: rgba(111, 91, 255, 0.08);
  }
  .dumb__row--maze,
  .dumb__row--maze + .dumb__row {
    border-top-color: transparent;
  }
  .dumb__row--maze + .dumb__row--maze {
    margin-top: 2px;
  }
  .dumb__row--maze .dumb__name {
    color: var(--fg);
  }
  .dumb__tag {
    flex: none;
    padding: 1px 5px;
    border-radius: 4px;
    background: rgba(111, 91, 255, 0.35);
    box-shadow: inset 0 0 0 1px rgba(155, 140, 255, 0.6);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: #e4dfff;
  }
  .dumb__track {
    position: relative;
    height: 14px;
    margin: 0 7px;
    background: linear-gradient(90deg, rgba(241, 241, 241, 0.06) 1px, transparent 1px) 0 0 / 12.5% 100%;
  }
  .dumb__seg {
    position: absolute;
    top: 6px;
    left: calc(var(--a) * 100%);
    width: calc((var(--b) - var(--a)) * 100%);
    height: 2px;
    background: rgba(241, 241, 241, 0.25);
    transform-origin: 0 50%;
    transform: scaleX(0);
    transition: transform 0.9s var(--ease-out) calc(0.2s + var(--i) * 0.05s);
  }
  .dumb__row--up .dumb__seg {
    background: linear-gradient(90deg, #8d8a96, var(--accent));
  }
  .dumb__row--down .dumb__seg {
    background: linear-gradient(90deg, #f6c27a, #8d8a96);
    transform-origin: 100% 50%;
  }
  .dumb__dot {
    position: absolute;
    top: 1px;
    left: calc(var(--x) * 100%);
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
  }
  .dumb__dot--old {
    background: #8d8a96;
  }
  .dumb__dot--new {
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(155, 140, 255, 0.18);
    opacity: 0;
    transition: opacity 0.4s ease calc(0.7s + var(--i) * 0.05s);
  }
  .dumb__row--down .dumb__dot--new {
    background: #f6c27a;
    box-shadow: 0 0 0 3px rgba(246, 194, 122, 0.18);
  }
  .dumb.is-on .dumb__seg {
    transform: none;
  }
  .dumb.is-on .dumb__dot--new {
    opacity: 1;
  }
  .dumb__vals {
    font-variant-numeric: tabular-nums;
    color: var(--fg-3);
    text-align: right;
  }
  .dumb__vals b {
    font-weight: 500;
    color: var(--fg);
  }
  .dumb__row--down .dumb__vals b {
    color: #f6c27a;
  }
  .dumb__time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-3);
    text-align: right;
  }
  @media (max-width: 699px) {
    .dumb__axis,
    .dumb__row {
      grid-template-columns: 104px minmax(0, 1fr) 44px;
      gap: 10px;
      min-width: 0;
    }
    .dumb__axis > span:last-child,
    .dumb__time,
    .dumb__time-note {
      display: none;
    }
    .dumb__row {
      font-size: 13px;
    }
    .dumb__axis-note {
      margin-left: 0;
    }
  }

  /* ---------- Ship ---------- */
  .renames {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .renames li {
    display: grid;
    gap: 6px 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(17px, 1.4vw, 21px);
    letter-spacing: -0.015em;
  }
  .renames__from {
    color: var(--fg-3);
    text-decoration: line-through;
    text-decoration-color: rgba(241, 241, 241, 0.3);
  }
  .renames__arrow {
    display: none;
  }
  .renames__to {
    color: var(--fg);
  }
  @media (min-width: 900px) {
    .renames li {
      grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr);
      align-items: center;
    }
    .renames__arrow {
      display: block;
      position: relative;
      height: 1px;
      background: linear-gradient(90deg, var(--line-strong), var(--accent));
    }
    .renames__arrow::after {
      content: '';
      position: absolute;
      right: 0;
      top: -4px;
      width: 8px;
      height: 8px;
