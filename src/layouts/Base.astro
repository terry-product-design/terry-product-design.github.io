---
import '../styles/global.css';
import outfitLatin from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import { site } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative path to a share image; defaults to the homepage one. */
  image?: string;
}

const { title = site.title, description = site.description, image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? `${base}/og.jpg`, Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08050f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      site.analytics && (
        <script is:inline define:vars={{ endpoint: `${site.analytics.replace(/\/$/, '')}/e` }}>
          // Page-view beacon for the private analytics dashboard (analytics/). No cookies.
          // Live site only; visit with ?notrack once to exclude this browser, ?track to undo.
          (function () {
            if (location.hostname !== 'terry-product-design.github.io') return;
            try {
              if (/[?&]notrack\b/.test(location.search)) localStorage.setItem('notrack', '1');
              if (/[?&]track\b/.test(location.search)) localStorage.removeItem('notrack');
              if (localStorage.getItem('notrack')) return;
            } catch (e) {}
            var send = function (o) {
              var b = JSON.stringify(o);
              if (!(navigator.sendBeacon && navigator.sendBeacon(endpoint, b))) fetch(endpoint, { method: 'POST', body: b, keepalive: true });
            };
            var utm = new URLSearchParams(location.search).get('utm_source') || '';
            // id: this page view. shown: ms visible so far. A "still here" ping every 30 s while visible
            // lets the dashboard show who is viewing right now.
            var id = '', shown = 0, since = 0, beat = 0;
            var elapsed = function () { return shown + (since ? Date.now() - since : 0); };
            var ping = function () { if (id) send({ t: 'h', id: id, d: elapsed() }); };
            var resume = function () { since = Date.now(); clearInterval(beat); beat = setInterval(ping, 30000); };
            var pause = function () {
              clearInterval(beat);
              if (since) { shown += Date.now() - since; since = 0; }
              if (id) send({ t: 'l', id: id, d: shown });
            };
            var start = function (restored) {
              id = Math.random().toString(36).slice(2) + Date.now().toString(36);
              shown = 0;
              // A page restored with Back is a view from within the site, not a new entrance.
              send({ t: 'v', id: id, p: location.pathname, r: restored ? location.href : document.referrer, u: restored ? '' : utm });
              resume();
            };
            // Count a view once the page is on screen (not while preloaded or opened in a background tab).
            if (document.visibilityState === 'visible') start(false);
            document.addEventListener('visibilitychange', function () {
              if (document.visibilityState === 'hidden') { if (since) pause(); }
              else if (!id) start(false);
              else { resume(); ping(); }
            });
            addEventListener('pagehide', function () { if (since) pause(); });
            // Back / forward restores the page from memory without running this script again.
            addEventListener('pageshow', function (e) {
              if (!e.persisted) return;
              if (since) pause();
              start(true);
            });
          })();
        </script>
      )
    }
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      setTimeout(function () {
        if (!window.__ready) document.documentElement.classList.add('no-anim');
      }, 3500);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="ambient" aria-hidden="true"></div>
    <div class="guides" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
