{
  "name": "portfolio-analytics",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:init:local": "wrangler d1 execute portfolio-analytics --local --file=schema.sql",
    "db:seed:local": "node scripts/seed.mjs > .wrangler/seed.sql && wrangler d1 execute portfolio-analytics --local --file=.wrangler/seed.sql",
    "db:init:remote": "wrangler d1 execute portfolio-analytics --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "dev:demo": "node scripts/simulate.mjs & wrangler dev --port 8787"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
